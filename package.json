{
  "name": "whitepallace",
  "version": "1.0.0",
  "description": "Projeto para treinar programação",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && npm run services:wait:database && npm run migration:up && next dev",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "eslint .",
    "lembrete": "configurar eslint next13",
    "test": "npm run services:up && concurrently -n next,jest --hide next -k -s command-jest \"next dev\"  \"jest --runInBand --verbose\"",
    "test:watch": "jest --watchAll --runInBand",
    "migrations:create": "node-pg-migrate --migrations-dir infra/migrations create",
    "migrations:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
    "services:wait:database": "node infra/scripts/wait-for-postgres.js",
    "prepare": "husky",
    "commit": "cz"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "async-retry": "1.3.3",
    "docker-compose": "1.4.2",
    "dotenv": "16.4.5",
    "dotenv-expand": "11.0.6",
    "next": "14.2.5",
    "node-pg-migrate": "7.6.1",
    "pg": "8.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "19.4.0",
    "@commitlint/config-conventional": "19.2.2",
    "@eslint/js": "9.39.4",
    "commitizen": "4.3.2",
    "concurrently": "8.2.2",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-jest": "28.8.0",
    "eslint-plugin-react": "7.37.5",
    "globals": "17.7.0",
    "husky": "9.1.4",
    "jest": "29.7.0",
    "prettier": "3.8.3",
    "wait-on": "8.0.5"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "overrides": {
    "eslint-plugin-jest": {
      "@typescript-eslint/utils": "^8.0.0"
    }
  }
}
